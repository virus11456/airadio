# Copy to .env and fill in. Required keys are marked.

# ---- Music brain ----
MINIMAX_API_KEY=                # required for DJ planning + chat
MINIMAX_MODEL=MiniMax-M2
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TIMEOUT_MS=60000
MINIMAX_TEMPERATURE=0.7
MINIMAX_MAX_TOKENS=2048

# ---- Music sources ----
# Comma- or whitespace-separated. The hourly sync iterates each playlist.
# Leave a single ID for the original behaviour. Extra IDs join the same library.
SUNO_PLAYLIST_IDS=ec4ce934-c6b5-4b3b-8479-1f91445677ca

NCM_API_URL=http://localhost:3100
NCM_COOKIE=                     # optional — unlocks more songs for logged-in account

# ---- TTS ----
FISH_API_KEY=
FISH_VOICE_ID=
EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural

# ---- Weather (optional, falls back to wttr.in) ----
OWM_KEY=
OWM_CITY=Taipei

# ---- Cover generation ----
# pollinations.ai is the default — no API key needed. Override the visual style here.
COVER_MODEL=flux
COVER_STYLE=

# ---- Behavior ----
PORT=8080
TZ=Asia/Taipei
DJ_INTERVAL_SONGS=1
DJ_SAY_MIN_CHARS=40
DJ_SAY_MAX_CHARS=70
QUEUE_LOW_WATER=1
TTS_CACHE_DIR=cache/tts
MUSIC_CACHE_DIR=cache/music

# Optional integrations
LARK_WEBHOOK=
